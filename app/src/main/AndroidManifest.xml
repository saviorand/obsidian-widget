<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets ACTION_EDIT/AgentTriggerReceiver start an activity from a
         plain background broadcast (a panel tap, an am broadcast, an
         agent-triggered action). Android 10+ otherwise silently blocks
         startActivity() from a BroadcastReceiver unless the app holds
         this permission or the launch was a genuine, system-recognized
         user tap (e.g. a real widget's PendingIntent via
         bridge:click_handle(), which is why that path never needed it).
         Requires one manual grant: Settings > Apps > Obsidian Widget >
         Display over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="md.obsidian" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="obsidian" />
        </intent>
    </queries>

    <application
        android:name=".ObsidianWidgetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ObsidianWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ObsidianWidget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditNoteActivity"
            android:label="Edit Note"
            android:exported="false"
            android:theme="@style/Theme.ObsidianWidget.Dialog"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true" />

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ObsidianWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ObsidianWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.obsidianwidget.ACTION_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- ObsidianWidgetProvider2/3/4: same behavior (empty subclasses),
             separate components so a second/third/fourth AIO content-slot
             wrapper gets tracked independently; see the class comment. -->
        <receiver
            android:name=".ObsidianWidgetProvider2"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.obsidianwidget.ACTION_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2" />
        </receiver>

        <receiver
            android:name=".ObsidianWidgetProvider3"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.obsidianwidget.ACTION_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_3" />
        </receiver>

        <receiver
            android:name=".ObsidianWidgetProvider4"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.obsidianwidget.ACTION_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_4" />
        </receiver>

        <activity
            android:name=".AgentChatActivity"
            android:label="Agent"
            android:exported="false"
            android:theme="@style/Theme.ObsidianWidget.Dialog.Light"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".AgentWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agent_widget_info" />
        </receiver>

        <service
            android:name=".ChecklistWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name=".NewNoteActivity"
            android:label="New Note"
            android:exported="false"
            android:theme="@style/Theme.ObsidianWidget.Dialog"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".NotesWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_widget_info" />
        </receiver>

        <service
            android:name=".NotesBrowserService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".AioBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.obsidianwidget.aio.ACTION_REPORT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AgentTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.obsidianwidget.aio.ACTION_AGENT_SIGNAL" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
