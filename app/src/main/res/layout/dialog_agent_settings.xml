<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agent host"
        android:textColor="@color/chat_text_secondary_light"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/settings_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background_light"
        android:inputType="textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/chat_text_light"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Port"
        android:textColor="@color/chat_text_secondary_light"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/settings_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background_light"
        android:inputType="number"
        android:padding="12dp"
        android:textColor="@color/chat_text_light"
        android:textSize="14sp"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fallback (MiMo)"
        android:textColor="@color/chat_text_light"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Used when the agent host isn't reachable. Billed per token, and its tools can only read and write notes — not Claude Code's full tool set."
        android:textColor="@color/chat_text_secondary_light"
        android:textSize="11sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MiMo API key"
        android:textColor="@color/chat_text_secondary_light"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/settings_mimo_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background_light"
        android:inputType="textPassword"
        android:hint="empty means no fallback"
        android:padding="12dp"
        android:textColor="@color/chat_text_light"
        android:textColorHint="@color/chat_text_secondary_light"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MiMo endpoint"
        android:textColor="@color/chat_text_secondary_light"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/settings_mimo_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background_light"
        android:inputType="textUri"
        android:padding="12dp"
        android:textColor="@color/chat_text_light"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MiMo model"
        android:textColor="@color/chat_text_secondary_light"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/settings_mimo_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background_light"
        android:inputType="textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/chat_text_light"
        android:textSize="14sp" />
</LinearLayout>
</ScrollView>
