<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notes_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/notes_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notes"
            android:textColor="@color/obsidian_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/notes_widget_new"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="New note"
            android:src="@drawable/ic_add"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/notes_widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:src="@android:drawable/stat_notify_sync"
            android:scaleType="centerInside" />
    </LinearLayout>

    <TextView
        android:id="@+id/notes_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/no_vault_selected"
        android:textColor="@color/obsidian_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/notes_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:clipToPadding="false" />

</LinearLayout>
