<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agent_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/agent_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agent"
        android:textColor="@color/obsidian_text"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/agent_widget_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/agent_widget_placeholder"
        android:textColor="@color/obsidian_text_secondary"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
