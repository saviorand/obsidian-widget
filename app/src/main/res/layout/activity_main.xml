<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Obsidian Widget"
        android:textColor="@color/obsidian_text"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/main_vault_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No vault selected yet"
        android:textColor="@color/obsidian_text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/main_select_vault"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minHeight="0dp"
        android:background="@drawable/button_background"
        android:text="Choose vault folder"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This grants every widget's vault access at once. After that, add a widget from Long-press home screen → Widgets → Obsidian Widget (or via your Lua launcher's script picker)."
        android:textColor="@color/obsidian_text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        android:alpha="0.6" />

</LinearLayout>
